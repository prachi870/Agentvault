# Comments must be on their own line (inline comments are parsed as part of the value).
# This file covers process-wide settings only. Per-connector credentials (Confluence, Jira,
# Notion, SharePoint, Google Drive, email) are NOT set here - they go in each connector's
# `config` JSON via POST /api/v1/connectors, since a deployment can have several connectors of
# the same kind (e.g. two Jira instances) with different creds. See "Connector credentials" below.

# ---- App ----
# ENV: dev | test | prod (prod also requires persistent Redis/Qdrant/S3 and cloud model providers)
ENV=dev
SECRET_KEY=
RECEIPT_SIGNING_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---- Data stores (docker-compose overrides these for its own containers) ----
# PostgreSQL example: postgresql://user:pass@host:5432/esakip
DATABASE_URL=sqlite:///./esakip.db
# In prod, run `alembic upgrade head` and set this false (enforced by config.py)
AUTO_CREATE_TABLES=true
# Empty = in-process fallback (rate limiting/caching only work). Example: redis://localhost:6379/0
# Also required for the Phase 3/4 background job queue (see scripts/worker.py) - without it,
# connector syncs and reindex jobs just run inline in the API request instead of being queued.
REDIS_URL=
# Empty = embedded in-memory Qdrant. Cloud: https://<id>.<region>.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=
# Optional: persist embedded Qdrant on disk (dev only)
QDRANT_PATH=
# local | s3
STORAGE_BACKEND=local
S3_BUCKET=esakip-documents
S3_REGION=us-east-1
# MinIO / localstack only
S3_ENDPOINT_URL=
# AWS credentials come from the standard AWS env vars / IAM role, not from this file

# ---- Models ----
# local = offline extractive baseline | openai | anthropic | gemini (provider packages in requirements-llm.txt)
LLM_PROVIDER=gemini
# Blank = provider default (gemini -> gemini-2.5-flash)
LLM_MODEL=
# hash = offline lexical embeddings | openai | gemini
EMBEDDING_PROVIDER=gemini
# Blank = provider default (gemini -> models/text-embedding-004)
EMBEDDING_MODEL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Google AI Studio key (LangChain reads this automatically) - console.cloud.google.com/apis or aistudio.google.com/apikey
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# ---- Ingestion ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_MB=25
CONNECTOR_ALLOWED_ROOT=./data/connector_root
# Phase 3: opt-in periodic connector sync (checks every 1m which connectors are due, per their
# own sync_interval_minutes). Needs REDIS_URL for real background execution; without it, sync
# still runs but blocks the scheduler tick thread.
SCHEDULER_ENABLED=false

# ---- RAG behaviour ----
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
RETRIEVAL_TOP_K=8
MAX_CONTEXT_CHARS=6000
MAX_CHUNKS_PER_DOC=3
MIN_EVIDENCE_SCORE=0.30
MIN_CONFIDENCE=0.35
CLAIM_SUPPORT_THRESHOLD=0.60
MAX_RETRIEVAL_RETRIES=1
FRESHNESS_HALF_LIFE_DAYS=365
STALE_AFTER_DAYS=730
INJECTION_BLOCK_THRESHOLD=0.70
# Phase 4: ensembles a small ML classifier (scikit-learn) with the regex heuristics in
# app/services/injection.py. Needs: pip install -r requirements-classifier.txt; degrades
# gracefully to heuristics-only if not installed.
INJECTION_CLASSIFIER_ENABLED=true

# ---- Hybrid retrieval (Phase 4) ----
# Dense (cosine) + sparse (BM25-ish lexical) retrieval, fused via Qdrant's built-in RRF.
# No extra credentials needed - this runs against the same Qdrant instance as QDRANT_URL above.
HYBRID_RETRIEVAL_ENABLED=true
# Cross-encoder rerank of the fused candidates. Needs: pip install -r requirements-ml.txt
# (sentence-transformers); falls back to a lexical rerank if not installed. No API key needed -
# the model downloads from Hugging Face on first use (set HF_HOME to control the cache dir).
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=20

# ---- Observability (Phase 4) ----
# text | json (structured JSON logs, one object per line)
LOG_FORMAT=text
AUDIT_LOG_ENABLED=true
# OpenTelemetry traces - off by default. If enabled, point it at a local collector (e.g. an
# OTel Collector or Jaeger) - no API key needed for a self-hosted endpoint.
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=http://localhost:4318

# =====================================================================================
# Connector credentials - NOT read from this file. Each connector's creds are passed once,
# in its `config` JSON, when you create it:
#   POST /api/v1/connectors  { "name": ..., "kind": "confluence", "config": {...}, ... }
# Real creds you'll need to have ready, per connector kind (app/services/connectors/*.py):
#
#   confluence  -> base_url, email, api_token
#                  Atlassian API token: id.atlassian.com/manage-profile/security/api-tokens
#   jira        -> base_url, email, api_token   (same Atlassian API token as Confluence)
#   notion      -> api_key  (internal integration token; share the token with the target pages
#                  in Notion first - www.notion.so/my-integrations)
#   sharepoint  -> tenant_id, client_id, client_secret, site_id
#                  Azure AD App Registration (app-only, client-credentials grant) with
#                  Sites.Read.All (Application) Graph API permission, admin-consented -
#                  portal.azure.com > App registrations
#   drive       -> service_account_json (the full downloaded key file, as JSON), optionally
#                  impersonate_user for domain-wide delegation
#                  Google Cloud service account with Drive API enabled -
#                  console.cloud.google.com/iam-admin/serviceaccounts
#   email       -> host, username, password (an app password, not your real password, for
#                  Gmail/M365 - most providers require this for IMAP with 2FA enabled)
#
# Optional on every connector: acl_map (maps source-side groups/spaces/projects to ESAKIP
# roles - see each connector's module docstring), webhook_secret (for push-sync via
# POST /api/v1/webhooks/connectors/{id}), sync_interval_minutes (scheduled sync).
# =====================================================================================
