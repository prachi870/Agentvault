{
  "family": "esakip-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/esakipECSExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/esakipECSTaskRole",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/esakip-api:latest",
      "essential": true,
      "command": ["python", "scripts/worker.py"],
      "environment": [
        { "name": "ENV", "value": "prod" },
        { "name": "AUTO_CREATE_TABLES", "value": "false" },
        { "name": "STORAGE_BACKEND", "value": "s3" },
        { "name": "S3_BUCKET", "value": "esakip-documents-prod" },
        { "name": "S3_REGION", "value": "REGION" },
        { "name": "LLM_PROVIDER", "value": "gemini" },
        { "name": "EMBEDDING_PROVIDER", "value": "gemini" },
        { "name": "LOG_FORMAT", "value": "json" },
        { "name": "SCHEDULER_ENABLED", "value": "false" }
      ],
      "secrets": [
        { "name": "SECRET_KEY", "valueFrom": "SECRET_ARN_SECRET_KEY" },
        { "name": "RECEIPT_SIGNING_KEY", "valueFrom": "SECRET_ARN_RECEIPT_SIGNING_KEY" },
        { "name": "DATABASE_URL", "valueFrom": "SECRET_ARN_DATABASE_URL" },
        { "name": "REDIS_URL", "valueFrom": "SECRET_ARN_REDIS_URL" },
        { "name": "QDRANT_URL", "valueFrom": "SECRET_ARN_QDRANT_URL" },
        { "name": "QDRANT_API_KEY", "valueFrom": "SECRET_ARN_QDRANT_API_KEY" },
        { "name": "GOOGLE_API_KEY", "valueFrom": "SECRET_ARN_GOOGLE_API_KEY" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/esakip-worker",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ]
}
