# ========================================================================================
# ESAKIP — Production Environment Variables
# Copy to .env.prod and fill in real values before deploying.
# ========================================================================================

# ---- App ----
ENV=prod
SECRET_KEY=<generate-with: python -c "import secrets; print(secrets.token_urlsafe(64))">
RECEIPT_SIGNING_KEY=<generate-with: python -c "import secrets; print(secrets.token_urlsafe(64))">
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["https://your-domain.com"]

# ---- Data stores ----
# RDS PostgreSQL
DATABASE_URL=postgresql://esakip:<password>@<rds-endpoint>:5432/esakip
AUTO_CREATE_TABLES=false

# ElastiCache Redis
REDIS_URL=redis://<elasticache-endpoint>:6379/0

# Qdrant Cloud
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io
QDRANT_API_KEY=<qdrant-api-key>
QDRANT_PATH=

# S3
STORAGE_BACKEND=s3
S3_BUCKET=esakip-documents-prod
S3_REGION=us-east-1
S3_ENDPOINT_URL=

# ---- Models ----
LLM_PROVIDER=gemini
LLM_MODEL=
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=
GOOGLE_API_KEY=<your-google-api-key>

# ---- Ingestion ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_MB=25
CONNECTOR_ALLOWED_ROOT=/srv/data/connector_root
SCHEDULER_ENABLED=false

# ---- RAG behaviour ----
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
RETRIEVAL_TOP_K=8
MAX_CONTEXT_CHARS=6000
MAX_CHUNKS_PER_DOC=3
MIN_EVIDENCE_SCORE=0.30
MIN_CONFIDENCE=0.35
CLAIM_SUPPORT_THRESHOLD=0.60
MAX_RETRIEVAL_RETRIES=1
FRESHNESS_HALF_LIFE_DAYS=365
STALE_AFTER_DAYS=730
INJECTION_BLOCK_THRESHOLD=0.70
INJECTION_CLASSIFIER_ENABLED=true
HYBRID_RETRIEVAL_ENABLED=true
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=20

# ---- Observability ----
LOG_FORMAT=json
AUDIT_LOG_ENABLED=true
OTEL_ENABLED=true
OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318

# ---- Bcrypt (lower for faster tests, 12 in prod) ----
BCRYPT_ROUNDS=12
