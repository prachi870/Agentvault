# Agentvault production environment reference.
# Configure these values in Render; never commit production secrets.
ENV=prod
SECRET_KEY=<at-least-32-random-characters>
RECEIPT_SIGNING_KEY=<at-least-32-random-characters>
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Render Postgres and Key Value connection URLs
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
AUTO_CREATE_TABLES=false
REDIS_URL=redis://<elasticache-endpoint>:6379/0

# Qdrant Cloud
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io
QDRANT_API_KEY=<qdrant-api-key>

# S3-compatible object storage (AWS S3 or Cloudflare R2)
STORAGE_BACKEND=s3
S3_BUCKET=<bucket-name>
S3_REGION=us-east-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>

# Gemini
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_API_KEY=<your-google-api-key>

# Worker and scheduler
SCHEDULER_ENABLED=false

LOG_FORMAT=json
